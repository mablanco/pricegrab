<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 6..11. An empty ruleset does NOT mean
  "back up nothing": it means "back up everything". Back up only the
  appearance preferences DataStore (theme + dynamic colour, non-sensitive)
  so any file added later stays out of backups until it is listed here.
-->
<full-backup-content>
    <include domain="file" path="datastore/appearance_preferences.preferences_pb" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12+. Mirrors backup_rules.xml:
  only the non-sensitive appearance preferences DataStore is included, so any
  file added later stays out until it is listed here explicitly.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/appearance_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/appearance_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
